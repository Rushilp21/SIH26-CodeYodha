# BhumiSetu environment (copy to .env)

# --- CRS contract (do not mix lat/lon with metric calculations) ---
STORAGE_CRS=EPSG:4326
PROCESSING_CRS=EPSG:32645

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-for-demo-only
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_MODE=true

# --- Database ---
POSTGRES_USER=bhumisetu
POSTGRES_PASSWORD=bhumisetu
POSTGRES_DB=bhumisetu
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://bhumisetu:bhumisetu@localhost:5432/bhumisetu

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
